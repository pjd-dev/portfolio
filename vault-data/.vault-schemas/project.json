{
  "id": "project",
  "title": "Project Note",
  "description": "Standard structure for project documentation with overview, scope, risks, and next actions",
  "appliesTo": {
    "frontmatter": {
      "type": "project"
    }
  },
  "headings": [
    {
      "id": "overview",
      "title": "Overview",
      "level": 2,
      "text": "Overview",
      "required": true,
      "contentRules": [
        {
          "id": "not_empty",
          "type": "nonEmpty",
          "message": "Overview section must describe the project"
        },
        {
          "id": "min_length",
          "type": "minLength",
          "minLength": 50,
          "message": "Overview should be at least 50 characters"
        }
      ]
    },
    {
      "id": "scope",
      "title": "Scope",
      "level": 2,
      "text": "Scope",
      "required": true,
      "children": [
        {
          "id": "in_scope",
          "title": "In Scope",
          "level": 3,
          "text": "In Scope",
          "required": true,
          "contentRules": [
            {
              "id": "has_items",
              "type": "bulletList",
              "minItems": 1,
              "message": "List what is in scope"
            }
          ]
        },
        {
          "id": "out_of_scope",
          "title": "Out of Scope",
          "level": 3,
          "text": "Out of Scope",
          "required": false
        }
      ]
    },
    {
      "id": "risks",
      "title": "Risks",
      "level": 2,
      "text": "Risks",
      "required": true,
      "contentRules": [
        {
          "id": "has_risks",
          "type": "bulletList",
          "minItems": 1,
          "message": "Identify at least one risk or write 'None identified'"
        }
      ]
    },
    {
      "id": "next_actions",
      "title": "Next Actions",
      "level": 2,
      "text": "Next Actions",
      "required": true,
      "contentRules": [
        {
          "id": "has_actions",
          "type": "todoList",
          "minItems": 1,
          "message": "Define at least one next action"
        }
      ]
    },
    {
      "id": "timeline",
      "title": "Timeline",
      "level": 2,
      "text": "Timeline",
      "required": false
    },
    {
      "id": "resources",
      "title": "Resources",
      "level": 2,
      "text": "Resources",
      "required": false
    }
  ],
  "allowUnknownHeadings": true
}
