{
  "id": "meeting",
  "title": "Meeting Note",
  "description": "Standard structure for meeting notes with context, decisions, and action items",
  "appliesTo": {
    "frontmatter": {
      "type": "meeting"
    }
  },
  "headings": [
    {
      "id": "attendees",
      "title": "Attendees",
      "level": 2,
      "text": "Attendees",
      "required": false,
      "contentRules": [
        {
          "id": "has_attendees",
          "type": "bulletList",
          "minItems": 1,
          "message": "List at least one attendee"
        }
      ]
    },
    {
      "id": "context",
      "title": "Context",
      "level": 2,
      "text": "Context",
      "required": true,
      "contentRules": [
        {
          "id": "not_empty",
          "type": "nonEmpty",
          "message": "Context section must not be empty"
        }
      ]
    },
    {
      "id": "decisions",
      "title": "Decisions",
      "level": 2,
      "text": "Decisions",
      "required": true,
      "contentRules": [
        {
          "id": "not_empty",
          "type": "nonEmpty",
          "message": "Decisions section must not be empty - record what was decided"
        }
      ]
    },
    {
      "id": "actions",
      "title": "Action Items",
      "level": 2,
      "text": "Actions",
      "required": true,
      "contentRules": [
        {
          "id": "has_todos",
          "type": "todoList",
          "minItems": 1,
          "message": "There should be at least one action item"
        }
      ]
    },
    {
      "id": "notes",
      "title": "Notes",
      "level": 2,
      "text": "Notes",
      "required": false
    }
  ],
  "allowUnknownHeadings": true
}
