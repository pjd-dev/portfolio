{
  "name": "vault-platform-full",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for vault-platform-full",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "pnpm install",
    "podman:run-all": "bash ./podman/run-all.sh",
    "podman:run-mcp": "bash ./podman/run-mcp.sh",
    "podman:run-vault": "bash ./podman/run-vault.sh",
    "podman:compose": "bash ./podman/podman-compose.sh",
    "podman:run-mcp-detached": "bash ./podman/run-mcp.sh &",
    "podman:run-all-detached": "bash ./podman/run-all.sh &",
    "build": "pnpm -w -r run build --filter \"apps/*\"",
    "lint": "pnpm -w -r run lint --filter \"apps/*\"",
    "typecheck": "pnpm -w -r run typecheck --filter \"apps/*\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest --runInBand --coverage"
  },
  "prepare": "husky install",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^4.0.15",
    "typescript": "^5.4.0",
    "eslint": "^8.0.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.1",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@vitest/coverage-v8": "^2.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm -w exec -- lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  }
}
