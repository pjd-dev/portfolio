{
  "name": "vault-platform-full",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for vault-platform-full",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "pnpm install",
    "podman:run-all": "bash ./podman/run-all.sh",
    "podman:run-mcp": "bash ./podman/run-mcp.sh",
    "podman:run-vault": "bash ./podman/run-vault.sh",
    "podman:compose": "bash ./podman/podman-compose.sh",
    "podman:run-mcp-detached": "bash ./podman/run-mcp.sh &",
    "podman:run-all-detached": "bash ./podman/run-all.sh &"
  }
}