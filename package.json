{
  "name": "vault-platform-full",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for vault-platform-full",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "pnpm install",
    "script:restart-all": "bash ./scripts/services/restart.sh",
    "script:init-volume": "bash ./scripts/infrastructure/init.sh",
    "script:sync": "bash ./scripts/utilities/sync-vault.sh",
    "script:tunnel": "bash ./scripts/utilities/tunnel.sh",
    "script:verify": "bash ./scripts/utilities/verify-vault.sh",
    "vault": "bash ./scripts/vault",
    "vault:services:start": "bash ./scripts/services/start.sh",
    "vault:services:stop": "bash ./scripts/services/stop.sh",
    "vault:services:restart": "bash ./scripts/services/restart.sh",
    "vault:services:status": "bash ./scripts/services/status.sh",
    "vault:services:logs": "bash ./scripts/services/logs.sh",
    "vault:infra:init": "bash ./scripts/infrastructure/init.sh",
    "vault:infra:clean": "bash ./scripts/infrastructure/clean.sh",
    "vault:infra:verify": "bash ./scripts/infrastructure/verify.sh",
    "vault:utilities:sync": "bash ./scripts/utilities/sync-vault.sh",
    "vault:utilities:tunnel": "bash ./scripts/utilities/tunnel.sh",
    "vault:utilities:verify": "bash ./scripts/utilities/verify-vault.sh",
    "build": "pnpm run build:auth || true && pnpm run build:mcp || true && pnpm run build:llm || true",
    "build:auth": "[ -d apps/auth ] && pnpm -C apps/auth run build || echo 'apps/auth not found'",
    "build:mcp": "[ -d apps/mcp ] && pnpm -C apps/mcp run build || echo 'apps/mcp not found'",
    "build:llm": "[ -d apps/llm-adapter ] && pnpm -C apps/llm-adapter run build || echo 'apps/llm-adapter not found'",
    "lint": "pnpm -w -r run lint --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "pnpm -w -r run typecheck --if-present",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --runInBand --coverage",
    "test:all": "pnpm -w -r --if-present run test",
    "test:coverage": "vitest run --coverage"
  },
  "prepare": "husky install",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.2.1"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm -w exec -- lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  }
}
