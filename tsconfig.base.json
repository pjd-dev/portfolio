{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@vault/common": ["packages/vault-common/src"],
      "@vault/common/*": ["packages/vault-common/src/*"],
      "@vault/mcp-core": ["packages/mcp-core/src"],
      "@vault/cod": ["packages/cod-core/src"],
      "@vault/cod/*": ["packages/cod-core/src/*"],
      "@vault/obsidian-tools": ["packages/obsidian/src"],
      "@vault/cod-tools": ["packages/cod/src"],
      "@vault/vault-tools": ["packages/vault/src"],
      "@vault/types": ["packages/vault-types/src"],
      "@vault/errors": ["packages/vault-errors/src"]
    }
  }
}
