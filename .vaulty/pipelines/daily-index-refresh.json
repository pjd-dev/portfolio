{
  "name": "daily-index-refresh",
  "steps": [
    {
      "type": "autoLink",
      "path": "tasks/**/*.md",
      "options": {
        "maxLinksPerParagraph": 2,
        "maxTotalLinks": 50
      }
    },
    {
      "type": "autoLink",
      "path": "goals/**/*.md",
      "options": {
        "maxLinksPerParagraph": 2,
        "maxTotalLinks": 50
      }
    },
    {
      "type": "metadata",
      "path": "core/index.md",
      "frontmatter": {
        "refreshed": "{{now}}"
      },
      "merge": true
    },
    {
      "type": "insert",
      "path": "core/index.md",
      "line": 1,
      "replacement": "> Index refreshed at {{now}}\\n"
    }
  ],
  "options": {
    "stopOnError": false,
    "previewMode": true
  }
}
