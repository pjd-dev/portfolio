{
  "name": "daily-healthcheck",
  "steps": [
    {
      "type": "metadata",
      "path": "core/health.md",
      "frontmatter": {
        "lastHealthcheck": "{{now}}",
        "status": "ok"
      },
      "merge": true
    },
    {
      "type": "metadata",
      "path": "core/world/World.md",
      "frontmatter": {
        "healthcheck": "{{now}}"
      },
      "merge": true
    },
    {
      "type": "insert",
      "path": "core/health.md",
      "line": 1,
      "replacement": "> Daily healthcheck logged at {{now}}\\n"
    }
  ],
  "options": {
    "stopOnError": false,
    "previewMode": true
  }
}
