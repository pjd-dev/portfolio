{
  "name": "weekly-prune-ops-journal",
  "steps": [
    {
      "type": "patch",
      "path": "_system/ops-journal.md",
      "operations": [
        {
          "type": "delete",
          "search": "(?s)^.*$",
          "replacement": "## Ops Journal\\n\\nPruned on {{now}}. Older entries archived offline.\\n"
        }
      ]
    }
  ],
  "options": {
    "stopOnError": false,
    "previewMode": true
  }
}
