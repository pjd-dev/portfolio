{
  "name": "@vault/api",
  "version": "1.0.0",
  "type": "module",
  "description": "REST API service exposing MCP tools without LLM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint -c ../../.eslintrc.cjs \"src/**/*.{ts,js,tsx}\" || true",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.3",
    "@vault/auth": "workspace:*",
    "@vault/common": "workspace:*",
    "@vault/errors": "workspace:*",
    "@vault/mcp-core": "workspace:*",
    "@vault/types": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^5.3.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
