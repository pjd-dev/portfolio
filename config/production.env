#!/bin/bash

################################################################################
# Production Deployment Configuration
# Phase 4 Objective 5: Production Deployment Infrastructure
#
# This file contains environment-specific configuration for production
# deployments including resource limits, replicas, and health checks.
################################################################################

set -euo pipefail

# ============================================================================
# Deployment Environment
# ============================================================================

# Production environment name
ENVIRONMENT="production"

# Application versions (override with git tags in CI/CD)
MCP_VERSION="${MCP_VERSION:-latest}"
VAULTY_VERSION="${VAULTY_VERSION:-latest}"

# ============================================================================
# Infrastructure Configuration
# ============================================================================

# Container Registry
REGISTRY="${REGISTRY:-ghcr.io}"
REGISTRY_ORG="${REGISTRY_ORG:-darrybook}"

# Image names
MCP_IMAGE="${REGISTRY}/${REGISTRY_ORG}/mcp:${MCP_VERSION}"
VAULTY_IMAGE="${REGISTRY}/${REGISTRY_ORG}/vaulty:${VAULTY_VERSION}"

# Pod and container configuration
POD_NAME="${POD_NAME:-vault-platform-prod}"
MCP_CONTAINER="${MCP_CONTAINER:-mcp-server}"
VAULTY_CONTAINER="${VAULTY_CONTAINER:-vaulty}"

# Network configuration
DOCKER_NETWORK="${DOCKER_NETWORK:-vault-network}"

# API CORS (comma-separated origins; true=allow all, false=disable)
CORS_ORIGIN="${CORS_ORIGIN:-http://localhost:8000,http://localhost:4200}"

# ============================================================================
# Volume Configuration
# ============================================================================

# Volume names
VAULT_VOLUME="${VAULT_VOLUME:-vault-prod}"
SHARED_VOLUME="${SHARED_VOLUME:-vault-shared-prod}"

# Volume mount points
VAULT_MOUNT="/vault"
SHARED_MOUNT="/shared"

# Persistent data paths
VAULT_DATA_PATH="${VAULT_DATA_PATH:-/mnt/vault-data}"
BACKUP_PATH="${BACKUP_PATH:-/mnt/backups}"
LOG_PATH="${LOG_PATH:-/var/log/vault-platform}"

# ============================================================================
# Port Configuration
# ============================================================================

# Service ports
VAULT_PORT="${VAULT_PORT:-3333}"
MCP_PORT="${MCP_PORT:-4000}"
HEALTH_CHECK_PORT="${HEALTH_CHECK_PORT:-8080}"

# Port bindings (host:container)
VAULT_PORT_BINDING="${VAULT_PORT}:3333"
MCP_PORT_BINDING="${MCP_PORT}:4000"
HEALTH_PORT_BINDING="${HEALTH_CHECK_PORT}:8080"

# ============================================================================
# Resource Limits
# ============================================================================

# CPU limits (in millicores: 1000m = 1 CPU)
MCP_CPU_LIMIT="${MCP_CPU_LIMIT:-2000m}"
VAULTY_CPU_LIMIT="${VAULTY_CPU_LIMIT:-2000m}"

# Memory limits
MCP_MEMORY_LIMIT="${MCP_MEMORY_LIMIT:-2Gi}"
VAULTY_MEMORY_LIMIT="${VAULTY_MEMORY_LIMIT:-4Gi}"

# CPU requests (minimum guaranteed)
MCP_CPU_REQUEST="${MCP_CPU_REQUEST:-500m}"
VAULTY_CPU_REQUEST="${VAULTY_CPU_REQUEST:-500m}"

# Memory requests
MCP_MEMORY_REQUEST="${MCP_MEMORY_REQUEST:-512Mi}"
VAULTY_MEMORY_REQUEST="${VAULTY_MEMORY_REQUEST:-1Gi}"

# ============================================================================
# Replica Configuration
# ============================================================================

# Number of replicas
MCP_REPLICAS="${MCP_REPLICAS:-2}"
VAULTY_REPLICAS="${VAULTY_REPLICAS:-2}"

# Health check replicas (should always be 1)
HEALTH_CHECK_REPLICAS="${HEALTH_CHECK_REPLICAS:-1}"

# ============================================================================
# Health Check Configuration
# ============================================================================

# Health check endpoints
VAULT_HEALTH_ENDPOINT="http://localhost:${VAULT_PORT}/health"
MCP_HEALTH_ENDPOINT="http://localhost:${MCP_PORT}/health"

# Health check timing (in seconds)
HEALTH_CHECK_INTERVAL="${HEALTH_CHECK_INTERVAL:-30}"
HEALTH_CHECK_TIMEOUT="${HEALTH_CHECK_TIMEOUT:-10}"
HEALTH_CHECK_RETRIES="${HEALTH_CHECK_RETRIES:-3}"

# Startup probe timing
STARTUP_PROBE_DELAY="${STARTUP_PROBE_DELAY:-10}"
STARTUP_PROBE_PERIOD="${STARTUP_PROBE_PERIOD:-10}"
STARTUP_PROBE_FAILURE_THRESHOLD="${STARTUP_PROBE_FAILURE_THRESHOLD:-30}"

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level
LOG_LEVEL="${LOG_LEVEL:-info}"

# Log retention
LOG_RETENTION_DAYS="${LOG_RETENTION_DAYS:-30}"

# Log format
LOG_FORMAT="${LOG_FORMAT:-json}"

# Structured logging
STRUCTURED_LOGGING="${STRUCTURED_LOGGING:-true}"

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup schedule (cron format)
BACKUP_SCHEDULE="${BACKUP_SCHEDULE:-0 2 * * *}"  # Daily at 2 AM

# Backup retention
BACKUP_RETENTION_DAYS="${BACKUP_RETENTION_DAYS:-30}"

# Backup verification
VERIFY_BACKUPS="${VERIFY_BACKUPS:-true}"

# ============================================================================
# Update Strategy
# ============================================================================

# Deployment strategy
DEPLOYMENT_STRATEGY="${DEPLOYMENT_STRATEGY:-rolling}"  # rolling or blue-green

# Rolling update configuration
MAX_SURGE="${MAX_SURGE:-1}"
MAX_UNAVAILABLE="${MAX_UNAVAILABLE:-0}"

# Blue-green configuration
TRAFFIC_SPLIT="${TRAFFIC_SPLIT:-90}"  # 90% to blue, 10% to green

# ============================================================================
# Security Configuration
# ============================================================================

# Security context
RUN_AS_USER="${RUN_AS_USER:-1000}"
RUN_AS_GROUP="${RUN_AS_GROUP:-1000}"
PRIVILEGED="${PRIVILEGED:-false}"

# Network policies
NETWORK_POLICY_ENABLED="${NETWORK_POLICY_ENABLED:-true}"
INGRESS_WHITELIST="${INGRESS_WHITELIST:-}"  # Comma-separated IPs

# ============================================================================
# Monitoring & Alerting
# ============================================================================

# Metrics collection
METRICS_ENABLED="${METRICS_ENABLED:-true}"
METRICS_PORT="${METRICS_PORT:-9090}"

# Alert thresholds
CPU_ALERT_THRESHOLD="${CPU_ALERT_THRESHOLD:-80}"
MEMORY_ALERT_THRESHOLD="${MEMORY_ALERT_THRESHOLD:-85}"
DISK_ALERT_THRESHOLD="${DISK_ALERT_THRESHOLD:-90}"

# Trace collection
TRACING_ENABLED="${TRACING_ENABLED:-false}"
TRACE_SAMPLE_RATE="${TRACE_SAMPLE_RATE:-0.1}"

# ============================================================================
# Automation Scheduling
# ============================================================================

# Pipeline scheduler
PIPELINE_SCHEDULER_ENABLED="${PIPELINE_SCHEDULER_ENABLED:-false}"
PIPELINE_SCHEDULER_INTERVAL_MS="${PIPELINE_SCHEDULER_INTERVAL_MS:-60000}"

# Recurring template scheduler
RECURRING_TEMPLATE_SCHEDULER_ENABLED="${RECURRING_TEMPLATE_SCHEDULER_ENABLED:-false}"
RECURRING_TEMPLATE_SCHEDULER_INTERVAL_MS="${RECURRING_TEMPLATE_SCHEDULER_INTERVAL_MS:-60000}"

# ============================================================================
# Deployment Approval
# ============================================================================

# Require manual approval
REQUIRE_APPROVAL="${REQUIRE_APPROVAL:-true}"

# Approval timeout (minutes)
APPROVAL_TIMEOUT="${APPROVAL_TIMEOUT:-30}"

# Approvers (comma-separated GitHub usernames)
APPROVERS="${APPROVERS:-}"

# ============================================================================
# Export for use in deployment scripts
# ============================================================================

export ENVIRONMENT
export MCP_VERSION VAULTY_VERSION
export REGISTRY REGISTRY_ORG
export MCP_IMAGE VAULTY_IMAGE
export POD_NAME MCP_CONTAINER VAULTY_CONTAINER
export DOCKER_NETWORK
export VAULT_VOLUME SHARED_VOLUME
export VAULT_MOUNT SHARED_MOUNT
export VAULT_DATA_PATH BACKUP_PATH LOG_PATH
export VAULT_PORT MCP_PORT HEALTH_CHECK_PORT
export VAULT_PORT_BINDING MCP_PORT_BINDING HEALTH_PORT_BINDING
export MCP_CPU_LIMIT VAULTY_CPU_LIMIT
export MCP_MEMORY_LIMIT VAULTY_MEMORY_LIMIT
export MCP_CPU_REQUEST VAULTY_CPU_REQUEST
export MCP_MEMORY_REQUEST VAULTY_MEMORY_REQUEST
export MCP_REPLICAS VAULTY_REPLICAS
export HEALTH_CHECK_INTERVAL HEALTH_CHECK_TIMEOUT
export LOG_LEVEL LOG_RETENTION_DAYS
export BACKUP_SCHEDULE BACKUP_RETENTION_DAYS
export DEPLOYMENT_STRATEGY MAX_SURGE MAX_UNAVAILABLE
export METRICS_ENABLED CPU_ALERT_THRESHOLD
export PIPELINE_SCHEDULER_ENABLED PIPELINE_SCHEDULER_INTERVAL_MS
export RECURRING_TEMPLATE_SCHEDULER_ENABLED RECURRING_TEMPLATE_SCHEDULER_INTERVAL_MS
export REQUIRE_APPROVAL


VAULTY_SCHED_ALLOWLIST=reward-auto-claim,avatar-daily-update,daily-healthcheck,daily-index-refresh,weekly-audit,weekly-prune-ops-journal,world-daily-update
VAULTY_SCHED_JOB__avatar_daily_update__PIPELINE=avatar-daily-update
VAULTY_SCHED_JOB__avatar_daily_update__INTERVAL_SEC=86400
VAULTY_SCHED_JOB__daily_healthcheck__PIPELINE=daily-healthcheck
VAULTY_SCHED_JOB__daily_healthcheck__INTERVAL_SEC=86400
VAULTY_SCHED_JOB__daily_index_refresh__PIPELINE=daily-index-refresh
VAULTY_SCHED_JOB__daily_index_refresh__INTERVAL_SEC=86400
VAULTY_SCHED_JOB__weekly_audit__PIPELINE=weekly-audit
VAULTY_SCHED_JOB__weekly_audit__INTERVAL_SEC=604800
VAULTY_SCHED_JOB__weekly_prune_ops_journal__PIPELINE=weekly-prune-ops-journal
VAULTY_SCHED_JOB__weekly_prune_ops_journal__INTERVAL_SEC=604800
VAULTY_SCHED_JOB__world_daily_update__PIPELINE=world-daily-update
VAULTY_SCHED_JOB__world_daily_update__INTERVAL_SEC=86400

echo "✅ Production deployment configuration loaded"
