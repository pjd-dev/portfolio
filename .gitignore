# Vault data (keep local, don't track)
vault-data/

# Node / JavaScript
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp/
.pnp.js
.pnp.cjs
.env.local
.env.*.local

# Do NOT ignore lockfiles used by the repo (keep pnpm/yarn/npm lockfiles committed)
# (example: pnpm-lock.yaml, package-lock.json, yarn.lock) — keep them in VCS

# Builds / bundlers / caches
# Note: Keep scripts/build/ (build scripts), only ignore app-level build outputs
dist/
*/build/
apps/*/build/
coverage/
.nyc_output/
.cache/
.vite/
.out/
.esbuild/
*.map

# TypeScript
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.env.* 
pip-wheel-metadata/
__pypackages__/
.pytest_cache/
.mypy_cache/
.tox/
celerybeat-schedule

# Docker
docker-compose.override.yml
docker-compose.local.yml
.env.docker

# Logs and runtime files
logs/
*.log
*.log.*
*.tmp
tmp/
temp/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
.history/
*.swp
*.swo
*.DS_Store
Thumbs.db

# OS files
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db

# Git conflict / backup artifacts
*.orig
*.rej

# Misc binary / build artifacts
*.class
*.jar
*.war
*.exe
*.dll
*.so
*.dylib

# Generated by build systems / package managers
/.parcel-cache/
/.cache-loader/
/bower_components/

# Optional: local editor settings, credentials, secrets
secret-*.json
credentials.json
*.key
*.pem

# Ignore IDE-specific run outputs and system logs
local.properties
.vscode-test/

# Keep project-level lockfiles tracked (explicitly): do not ignore pnpm-lock.yaml, package-lock.json, yarn.lock, etc..DS_Store
apps/.DS_Store
