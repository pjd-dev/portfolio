{
  "title": "Darrybook – Work with me | Jean Paulette",
  "subtitle": "Let’s work together on something meaningful.",
  "meta": { "version": 1, "locale": "en" },
  "sections": [
    {
      "id": "work_with_me_form",
      "kind": "form",
      "title": "Work with me",
      "description": "Tell me about your project, timeline, and goals. Share what you need and I'll get back quickly with next steps.",
      "plxImg": {
        "src": "/poses/jump.webp",
        "alt": "Jean Paulette portrait"
      },
      "meta": {
        "api": {
          "endpoint": "/api/form",
          "method": "POST",
          "headers": { "Content-Type": "application/json" }
        },
        "successRedirect": null,
        "captcha": false,
        "delivery": "airtable"
      },
      "messages": {
        "success": "Thanks! Your request has been sent.",
        "error": "Sorry, something went wrong. Please try again.",
        "validation": "Please check the highlighted fields.",
        "loading": "Sending...",
        "scrollHint": "Scroll to see all the form fields.",
        "requiredHint": "Fields marked with * are required."
      },
      "fields": [
        {
          "id": "name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "placeholder": "Your name",
          "width": "1/2",
          "errors": [
            { "rule": { "type": "required" }, "message": "This field is required" },
            {
              "rule": { "type": "minLength", "value": 2 },
              "message": "Must be at least 2 characters"
            }
          ]
        },
        {
          "id": "email",
          "name": "email",
          "label": "Email",
          "type": "email",
          "placeholder": "your.email@example.com",
          "width": "1/2",
          "errors": [
            { "rule": { "type": "required" }, "message": "This field is required" },
            {
              "rule": { "type": "email" },
              "message": "Please enter a valid email address"
            }
          ]
        },
        {
          "id": "engagement",
          "name": "engagement",
          "label": "How can we work together?",
          "type": "select",
          "placeholder": "Choose an option",
          "defaultValue": "freelance",
          "width": "full",
          "options": [
            { "value": "full-time", "label": "Full-time role" },
            { "value": "contract", "label": "Contract / mission" },
            { "value": "freelance", "label": "Freelance project" },
            { "value": "collab", "label": "Collaboration" },
            { "value": "other", "label": "Other" }
          ],
          "errors": [
            { "rule": { "type": "required" }, "message": "Please choose an option" }
          ]
        },
        {
          "id": "company",
          "name": "company",
          "label": "Company / Organization",
          "type": "text",
          "placeholder": "Your company name",
          "width": "1/3",
          "showWhen": {
            "mode": "and",
            "conditions": [
              {
                "fieldId": "engagement",
                "op": "in",
                "values": ["full-time", "contract", "freelance"]
              }
            ]
          },
          "errors": [
            {
              "rule": { "type": "minLength", "value": 2 },
              "message": "Must be at least 2 characters"
            }
          ]
        },
        {
          "id": "budget",
          "name": "budget",
          "label": "Budget",
          "type": "select",
          "placeholder": "Select a range",
          "width": "1/3",
          "options": [
            { "value": "<1k", "label": "< $1,000" },
            { "value": "1k-3k", "label": "$1,000 – $3,000" },
            { "value": "3k-5k", "label": "$3,000 – $5,000" },
            { "value": "5k-10k", "label": "$5,000 – $10,000" },
            { "value": "10k+", "label": "$10,000 +" }
          ],
          "showWhen": {
            "mode": "and",
            "conditions": [
              { "fieldId": "engagement", "op": "in", "values": ["freelance", "contract"] }
            ]
          }
        },
        {
          "id": "timeline",
          "name": "timeline",
          "label": "Timeline",
          "type": "text",
          "placeholder": "e.g., 2 weeks, 1 month",
          "width": "1/3",
          "showWhen": {
            "mode": "and",
            "conditions": [
              { "fieldId": "engagement", "op": "in", "values": ["freelance", "contract"] }
            ]
          }
        },
        {
          "id": "projectLink",
          "name": "projectLink",
          "label": "Project link",
          "type": "url",
          "placeholder": "https://your-project.com",
          "width": "full",
          "showWhen": {
            "mode": "and",
            "conditions": [
              {
                "fieldId": "engagement",
                "op": "in",
                "values": ["freelance", "contract", "collab"]
              }
            ]
          }
        },
        {
          "id": "message",
          "name": "message",
          "label": "Project details",
          "type": "textarea",
          "placeholder": "Tell me about scope, goals, and constraints...",
          "rows": 5,
          "width": "full",
          "errors": [
            { "rule": { "type": "required" }, "message": "This field is required" },
            {
              "rule": { "type": "minLength", "value": 10 },
              "message": "Message must be at least 10 characters"
            }
          ]
        },
        {
          "id": "privacy",
          "name": "privacy",
          "label": "By submitting this form, you agree that your data is used to respond and may be delivered by email or stored in Airtable depending on the form settings.",
          "type": "checkbox",
          "errors": [
            { "rule": { "type": "required" }, "message": "This field is required" }
          ]
        }
      ],
      "submit": "Send request",
      "ctas": []
    }
  ]
}
