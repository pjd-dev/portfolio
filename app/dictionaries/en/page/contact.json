{
  "title": "Darrybook – Portfolio of Jean Paulette | Contact Form",
  "subtitle": "Have a project in mind or just want to say hello?",
  "meta": { "version": 1, "locale": "en" },
  "sections": [
    {
      "id": "contact_form_en",
      "kind": "form",
      "title": "Send me a message",
      "description": "Have a project in mind or a collaboration to propose? Contact me here. I'll reply quickly.",
      "meta": {
        "api": {
          "endpoint": "/api/form",
          "method": "POST",
          "headers": { "Content-Type": "application/json" }
        },
        "successRedirect": null,
        "captcha": false,
        "delivery": "mail"
      },
      "messages": {
        "success": "Message sent successfully!",
        "error": "Failed to send message. Please try again.",
        "validation": "Some fields are invalid.",
        "loading": "Sending...",
        "scrollHint": "Scroll to see all the form fields.",
        "requiredHint": "Fields marked with * are required."
      },
      "fields": [
        {
          "id": "name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "placeholder": "Your name",
          "width": "full",
          "errors": [
            {
              "rule": { "type": "required" },
              "message": "This field is required"
            },
            {
              "rule": { "type": "minLength", "value": 2 },
              "message": "Must be at least 2 characters"
            }
          ]
        },
        {
          "id": "email",
          "name": "email",
          "label": "Email",
          "type": "email",
          "placeholder": "your.email@example.com",
          "width": "full",
          "errors": [
            {
              "rule": { "type": "required" },
              "message": "This field is required"
            },
            {
              "rule": { "type": "email" },
              "message": "Please enter a valid email address"
            }
          ]
        },
        {
          "id": "message",
          "name": "message",
          "label": "Message",
          "type": "textarea",
          "placeholder": "Tell me about your project or inquiry...",
          "rows": 5,
          "width": "full",
          "errors": [
            {
              "rule": { "type": "required" },
              "message": "This field is required"
            },
            {
              "rule": { "type": "minLength", "value": 10 },
              "message": "Message must be at least 10 characters"
            }
          ]
        },
        {
          "id": "privacy",
          "name": "privacy",
          "label": "By submitting this form, you agree that your data is used to respond and may be delivered by email or stored in Airtable depending on the form settings.",
          "type": "checkbox",
          "errors": [
            {
              "rule": { "type": "required" },
              "message": "This field is required"
            }
          ]
        }
      ],
      "submit": "Send Message",
      "ctas": []
    }
  ]
}
