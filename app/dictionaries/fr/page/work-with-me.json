{
  "title": "Darrybook – Travaillons ensemble | Jean Paulette",
  "subtitle": "Construisons quelque chose ensemble.",
  "meta": { "version": 1, "locale": "fr" },
  "sections": [
    {
      "id": "work_with_me_form",
      "kind": "heroForm",
      "title": "Travaillons ensemble",
      "headline": "",
      "plxImg": {
        "src": "/poses/jump_2.webp",
        "alt": "Portrait de Jean Paulette"
      },
      "form": {
        "title": "",
        "description": "Parlez-moi de votre projet, du timing et des objectifs. Dites-moi ce dont vous avez besoin et je reviens vers vous rapidement.",
        "meta": {
          "api": {
            "endpoint": "/api/form",
            "method": "POST",
            "headers": { "Content-Type": "application/json" }
          },
          "successRedirect": null,
          "captcha": false,
          "delivery": "airtable"
        },
        "messages": {
          "success": "Merci ! Votre demande a bien été envoyée.",
          "error": "Une erreur est survenue. Veuillez réessayer.",
          "validation": "Veuillez vérifier les champs en surbrillance.",
          "loading": "Envoi en cours...",
          "scrollHint": "Faites défiler pour voir tous les champs du formulaire.",
          "requiredHint": "Les champs marqués d’un * sont obligatoires."
        },
        "fields": [
          {
            "id": "name",
            "name": "name",
            "label": "Nom",
            "type": "text",
            "placeholder": "Votre nom",
            "width": "1/2",
            "errors": [
              { "rule": { "type": "required" }, "message": "Ce champ est requis" },
              {
                "rule": { "type": "minLength", "value": 2 },
                "message": "Doit contenir au moins 2 caractères"
              }
            ]
          },
          {
            "id": "email",
            "name": "email",
            "label": "Email",
            "type": "email",
            "placeholder": "votre.email@exemple.com",
            "width": "1/2",
            "errors": [
              { "rule": { "type": "required" }, "message": "Ce champ est requis" },
              {
                "rule": { "type": "email" },
                "message": "Veuillez entrer une adresse email valide"
              }
            ]
          },
          {
            "id": "engagement",
            "name": "engagement",
            "label": "Comment pouvons-nous travailler ensemble ?",
            "type": "select",
            "placeholder": "Choisissez une option",
            "defaultValue": "freelance",
            "width": "full",
            "options": [
              { "value": "full-time", "label": "Poste full-time" },
              { "value": "contract", "label": "Mission / contrat" },
              { "value": "freelance", "label": "Projet freelance" },
              { "value": "collab", "label": "Collaboration" },
              { "value": "other", "label": "Autre" }
            ],
            "errors": [
              { "rule": { "type": "required" }, "message": "Veuillez choisir une option" }
            ]
          },
          {
            "id": "company",
            "name": "company",
            "label": "Entreprise / Organisation",
            "type": "text",
            "placeholder": "Nom de votre entreprise",
            "width": "1/3",
            "showWhen": {
              "mode": "and",
              "conditions": [
                {
                  "fieldId": "engagement",
                  "op": "in",
                  "values": ["full-time", "contract", "freelance"]
                }
              ]
            },
            "errors": [
              {
                "rule": { "type": "minLength", "value": 2 },
                "message": "Doit contenir au moins 2 caractères"
              }
            ]
          },
          {
            "id": "budget",
            "name": "budget",
            "label": "Budget",
            "type": "select",
            "placeholder": "Sélectionnez une tranche",
            "width": "1/3",
            "options": [
              { "value": "<1k", "label": "< 1 000 €" },
              { "value": "1k-3k", "label": "1 000 – 3 000 €" },
              { "value": "3k-5k", "label": "3 000 – 5 000 €" },
              { "value": "5k-10k", "label": "5 000 – 10 000 €" },
              { "value": "10k+", "label": "10 000 € +" }
            ],
            "showWhen": {
              "mode": "and",
              "conditions": [
                { "fieldId": "engagement", "op": "in", "values": ["freelance", "contract"] }
              ]
            }
          },
          {
            "id": "timeline",
            "name": "timeline",
            "label": "Délai",
            "type": "text",
            "placeholder": "ex: 2 semaines, 1 mois",
            "width": "1/3",
            "showWhen": {
              "mode": "and",
              "conditions": [
                { "fieldId": "engagement", "op": "in", "values": ["freelance", "contract"] }
              ]
            }
          },
          {
            "id": "projectLink",
            "name": "projectLink",
            "label": "Lien du projet",
            "type": "url",
            "placeholder": "https://votre-projet.com",
            "width": "full",
            "showWhen": {
              "mode": "and",
              "conditions": [
                {
                  "fieldId": "engagement",
                  "op": "in",
                  "values": ["freelance", "contract", "collab"]
                }
              ]
            }
          },
          {
            "id": "message",
            "name": "message",
            "label": "Détails du projet",
            "type": "textarea",
            "placeholder": "Parlez-moi des objectifs, du périmètre et des contraintes...",
            "rows": 5,
            "width": "full",
            "errors": [
              { "rule": { "type": "required" }, "message": "Ce champ est requis" },
              {
                "rule": { "type": "minLength", "value": 10 },
                "message": "Le message doit contenir au moins 10 caractères"
              }
            ]
          },
          {
            "id": "privacy",
            "name": "privacy",
            "label": "En envoyant ce formulaire, vous acceptez que vos données soient utilisées pour vous répondre et puissent être envoyées par email ou enregistrées dans Airtable selon la configuration du formulaire.",
            "type": "checkbox",
            "errors": [{ "rule": { "type": "required" }, "message": "Ce champ est requis" }]
          }
        ],
        "submit": "Envoyer la demande"
      }
    }
  ]
}
