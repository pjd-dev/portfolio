# GitHub Personal Access Token (required)
# Generate at: https://github.com/settings/tokens
# Needs: repo (full control of private repositories)
GIT_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# GitHub repository owner/username
GIT_USERNAME=your-username

# GitHub repository name (can include .git suffix, recommended for PAT auth)
GIT_REPO=your-username/your-repo-name.git

# Git sync configuration
GIT_SYNC_INTERVAL=30
GIT_SYNC_PUSH=1
GIT_USER_NAME=Vaulty
GIT_USER_EMAIL=vaulty-bot@example.com


# Supabase Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Auth Service
AUTH_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Password Reset
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback

# OAuth Providers (Optional)
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OAUTH_DISCORD_ENABLED=false
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Podman / runtime configuration
# Pod names
POD_NAME=vaulty-pod
MCP_POD_NAME=mcp-pod

# Volume name for vault persistent data
VAULT_DATA_VOLUME=vault

# Local path for vault data (bind mount on host for persistence)
# Example: /Users/yourname/vault or /home/user/vault
LOCAL_VAULT_PATH=/path/to/local/vault

# Vault path inside container (normally /vault)
VAULT_PATH=/vault

# Port for MCP service to bind on host
MCP_PORT=4000

# Vault Sync Safety Limits
MAX_DELETIONS=15
MAX_DELETE_RATIO=0.5

# Sync mode: 'interval' (default) or 'realtime'
SYNC_MODE=interval

# Cloudflare Tunnel (optional)
CF_TUNNEL_NAME=obsidian-mcp
