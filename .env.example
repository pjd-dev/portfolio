# SMTP Configuration for Mailjet (or other SMTP provider)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=your_mailjet_api_key
SMTP_PASS=your_mailjet_secret_key
SMTP_CONTACT_TO=noreply@yourdomain.com
SMTP_CONTACT_FROM=your-email@example.com

# Airtable (optional form delivery)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Quotes
